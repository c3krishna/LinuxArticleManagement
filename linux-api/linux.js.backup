app.put('/api/admin/document/:id', (req, res) => {

    const {

        title,
        slug,
        category,
        content

    } = req.body;

    db.query(

        `
        UPDATE documents
        SET
            title = ?,
            slug = ?,
            category = ?,
            content = ?
        WHERE id = ?
        `,

        [

            title,
            slug,
            category,
            content,
            req.params.id

        ],

        (err, result) => {

            if (err) {

                return res.status(500).json(err);
            }

            res.json({
                success: true
            });
        }
    );
});

app.delete('/api/admin/document/:id', (req, res) => {

