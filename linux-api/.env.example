PORT=5000
DB_HOST=localhost
DB_USER=linuxuser
DB_PASSWORD=change-me
DB_NAME=linux_portal
# Long random value, e.g. `openssl rand -base64 32`. The API will not start without it.
JWT_SECRET=
SITE_URL=https://server-issue.online
# Optional: email notifications for enquiries and bookings. Without these, requests are only shown in the admin inbox.
# For Gmail use smtp.gmail.com, port 587 and an App Password (never the account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=
