# server-issue.online: the single site for articles, tools, services and the admin.
# linux.server-issue.online redirects here (see the linux.server-issue.online file).
# Installed as /etc/nginx/sites-available/server-issue (enabled by symlink).

upstream linux_backend {
    server 127.0.0.1:5000;
}

# Old /blog/<slug> links from the previous app, mapped to where each post lives now.
map $uri $old_blog_target {
    default                                      /articles;
    /blog/aws-cost-optimization                  /aws-cost-optimization;
    /blog/mysql-mariadb-comparison               /mysql-mariadb-comparison;
    /blog/ha-database-clusters-replication       /ha-database-clusters-replication;
    /blog/nginx-performance-tuning               /nginx-performance-tuning;
    /blog/docker-containerization-guide          /docker-containerization-guide;
    /blog/ssl-certificates-best-practices        /ssl-certificates-best-practices;
    /blog/linux-security-hardening               /linux-system-hardening-checklist;
    /blog/monitoring-prometheus-grafana          /monitoring-prometheus-grafana;
    /blog/asterisk-pbx-webrtc-web-calling-setup  /asterisk-pbx-webrtc-web-calling-setup;
    /blog/openssl-ssl-csr-key-crt-ca-setup       /openssl-ssl-csr-key-crt-ca-setup;
    /blog/ai-fundamentals                        /ai-fundamentals-understanding;
    /blog/kubernets-deep-dive                    /kubernets-deep-dive;
    /blog/devops-mystry-troubleshooting          /devops-mystry;
}

server {
    listen 80;
    listen [::]:80;
    server_name server-issue.online www.server-issue.online;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://server-issue.online$request_uri;
    }
}

# One canonical host for search engines.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.server-issue.online;

    ssl_certificate /etc/letsencrypt/live/server-issue.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server-issue.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://server-issue.online$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name server-issue.online;

    root /var/www/LinuxArticleManagement/linux-frontend/build;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/server-issue.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/server-issue.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/server-issue.online/chain.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

    access_log /var/log/nginx/server-issue-access.log;
    error_log /var/log/nginx/server-issue-error.log;

    # The API accepts up to 10 MB (article HTML, image uploads).
    client_max_body_size 10m;

    # Never serve dotfiles or editor backups.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    location ~ ~$ {
        deny all;
    }

    # Pages from the old server-issue.online app.
    location = /terms-and-conditions { return 301 /terms; }
    location = /cookie-policy { return 301 /privacy-policy; }
    location = /blog { return 301 /articles; }
    location ^~ /blog/ { return 301 $old_blog_target; }
    location = /admin/blog { return 301 /admin/articles; }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets never change. (A location with its own add_header drops the server-level ones,
    # which only matter for pages.)
    location /static/ {
        alias /var/www/LinuxArticleManagement/linux-frontend/build/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /api/ {
        proxy_pass http://linux_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Generated by the API from the live article list.
    location = /sitemap.xml {
        proxy_pass http://linux_backend/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /uploads/ {
        alias /var/www/LinuxArticleManagement/linux-api/uploads/;
    }
}
