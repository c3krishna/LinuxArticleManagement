# linux.server-issue.online moved to server-issue.online. Every URL redirects permanently to the same
# path there, so article links and search rankings carry over. The certificate is kept so HTTPS links
# still redirect cleanly; certbot renews it as before.

server {
    listen 80;
    server_name linux.server-issue.online;

    return 301 https://server-issue.online$request_uri;
}

server {
    listen 443 ssl http2;
    server_name linux.server-issue.online;

    ssl_certificate /etc/letsencrypt/live/linux.server-issue.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linux.server-issue.online/privkey.pem;

    access_log /var/log/nginx/linux-doc-access.log;
    error_log /var/log/nginx/linux-doc-error.log;

    return 301 https://server-issue.online$request_uri;
}
