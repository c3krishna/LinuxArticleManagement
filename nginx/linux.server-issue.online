upstream linux_backend {
    server 127.0.0.1:5000;
}

server {

    listen 80;
    server_name linux.server-issue.online;

    return 301 https://$host$request_uri;
}

server {

    listen 443 ssl http2;

    server_name linux.server-issue.online;

    ssl_certificate /etc/letsencrypt/live/linux.server-issue.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/linux.server-issue.online/privkey.pem;

    # ============================================
    # Logging
    # ============================================
    access_log /var/log/nginx/linux-doc-access.log;
    error_log /var/log/nginx/linux-doc-error.log;
    root /var/www/linux-docs;

    index index.html;

    ###################################################
    # REACT FRONTEND
    ###################################################

    location / {

        try_files $uri $uri/ /index.html;
    }


  #################################################
    # STATIC FILES
    #################################################

    location /static/ {

        alias /var/www/linux-docs/static/;

        expires 30d;

        access_log off;
    }


    ###################################################
    # NODE API
    ###################################################

    location /api/ {

        proxy_pass http://linux_backend/api/;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /uploads/ {

    alias /var/www/linux-api/uploads/;
}
}
